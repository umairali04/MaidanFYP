generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum Role {
  PLAYER
  GROUND_OWNER
  ADMIN
}

enum SportType {
  CRICKET
  FOOTBALL
  HOCKEY
  BADMINTON
  TENNIS
  SQUASH
}

enum DisputeStatus {
  PENDING
  IN_REVIEW
  RESOLVED
  REJECTED
}
//change added

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum WalletTransactionType {
  ADD_MONEY
  BOOKING_PAYMENT
  REFUND
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ParticipantRole {
  ORGANIZER
  PLAYER
}

enum ParticipantStatus {
  INVITED
  CONFIRMED
  DECLINED
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
}

// ============================================
// USER
// ============================================

model User {
  id          String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  phone       String?
  image       String?
  city        String?
  role        Role     @default(PLAYER)
  isVerified  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Player relations
  bookings            Booking[]
  reviews             Review[]
  notifications       Notification[]

  // Ground Owner relations
  ownedGrounds        Ground[]
  revenueReports      RevenueReport[]

  emailVerifications  EmailVerification[]

  passwordResets      PasswordReset[]

  disputes Dispute[] //changed

  walletBalance Float @default(0)
  walletTransactions WalletTransaction[]

  chatMessages  ChatMessage[]
  chatSessions  ChatSession[]

  preferredSports SportType[]

  sentConnections     Connection[]       @relation("SentConnections")
  receivedConnections Connection[]       @relation("ReceivedConnections")
  sentMessages        Message[]          @relation("SentMessages")
  receivedMessages    Message[]          @relation("ReceivedMessages")
  matchParticipations MatchParticipant[]
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ============================================
// GROUND
// ============================================

model Ground {
  id            String    @id @default(uuid())
  name          String
  description   String?
  sportType     SportType
  location      String
  city          String
  latitude      Float?
  longitude     Float?
  pricePerHour  Float
  images        String[]
  facilities    String[]
  openTime      String    // "06:00"
  closeTime     String    // "23:00"
  slotDuration  Int       @default(60) // minutes
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])

  bookings      Booking[]
  reviews       Review[]
  blockedSlots  BlockedSlot[]
  revenueReports RevenueReport[]

  disputes Dispute[] //chnaged

  maxPlayers Int @default(10)
}

// ============================================
// BLOCKED SLOT (owner blocks specific hours)
// ============================================

// ============================================
// BLOCKED SLOT (replaces both BlockedSlot + BlockedDay)
// ============================================

model BlockedSlot {
  id        String   @id @default(uuid())
  groundId  String
  date      DateTime
  startTime String   // "06:00" ← use ground's openTime for full day block
  endTime   String   // "23:00" ← use ground's closeTime for full day block
  reason    String?
  isFullDay Boolean  @default(false)  // just a helper flag for UI display
  createdAt DateTime @default(now())

  ground    Ground   @relation(fields: [groundId], references: [id])
}

// ============================================
// BOOKING
// ============================================

model Booking {
  id            String        @id @default(uuid())
  userId        String
  groundId      String
  bookingDate   DateTime
  startTime     String        // "10:00"
  endTime       String        // "12:00"
  duration      Int           // hours
  totalPrice    Float
  status        BookingStatus @default(PENDING)
  notes         String?
  
  // Owner self-booking flag
  isOwnerBooking Boolean      @default(false)
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          User          @relation(fields: [userId], references: [id])
  ground        Ground        @relation(fields: [groundId], references: [id])
  payment       Payment?

  disputes Dispute[] //changed

  participants MatchParticipant[]
}

// ============================================
// PAYMENT
// ============================================

model Payment {
  id            String        @id @default(uuid())
  bookingId     String        @unique
  amount        Float
  paymentStatus PaymentStatus @default(PENDING)
  transactionId String?
  stripeSessionId String?
  method        String?       // "JazzCash", "EasyPaisa", "Card", "Cash"
  paidAt        DateTime?
  createdAt     DateTime      @default(now())

  booking       Booking       @relation(fields: [bookingId], references: [id])
}

model WalletTransaction {
  id        String @id @default(uuid())
  userId    String
  amount    Float
  type      WalletTransactionType
  note      String?
  createdAt DateTime @default(now())

  user      User @relation(fields: [userId], references: [id])
}

// ============================================
// ChatBot
// ============================================

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  role      String   // "user" or "assistant"
  content   String
  createdAt DateTime @default(now())

  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
}

// ============================================
// REVIEW
// ============================================

model Review {
  id        String   @id @default(uuid())
  userId    String
  groundId  String
  rating    Int      // 1-5
  comment   String?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  ground    Ground   @relation(fields: [groundId], references: [id])
}

// ============================================
// REVENUE REPORT
// ============================================

model RevenueReport {
  id            String   @id @default(uuid())
  groundId      String
  ownerId       String
  month         Int
  year          Int
  totalBookings Int
  totalRevenue  Float
  createdAt     DateTime @default(now())

  ground        Ground   @relation(fields: [groundId], references: [id])
  owner         User     @relation(fields: [ownerId], references: [id])
}

// ============================================
// NOTIFICATION
// ============================================

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  type      String   // "BOOKING", "PAYMENT", "REVIEW", "SYSTEM"
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ============================================
// EMAIL VERIFICATION
// ============================================

model EmailVerification {
  id        String   @id @default(uuid())
  userId    String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// ============================================
// Dispute
// ============================================

model Dispute {
  id          String        @id @default(uuid())
  userId      String
  groundId    String?
  bookingId   String?
  title       String
  description String
  status      DisputeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id])
  ground  Ground?  @relation(fields: [groundId], references: [id])
  booking Booking? @relation(fields: [bookingId], references: [id])
}

// ============================================
// Connection
// ============================================

model Connection {
  id     String           @id @default(uuid())
  status ConnectionStatus @default(PENDING)

  senderId String
  sender   User   @relation("SentConnections", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("ReceivedConnections", fields: [receiverId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([senderId, receiverId])
}

// ============================================
// Messages to other players
// ============================================

model Message {
  id String @id @default(uuid())

  senderId String
  sender   User   @relation("SentMessages", fields: [senderId], references: [id])

  receiverId String
  receiver   User   @relation("ReceivedMessages", fields: [receiverId], references: [id])

  content     String?
  isRead      Boolean     @default(false)
  isDeleted   Boolean     @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  duration    Int?
  fileUrl     String?
  type        MessageType @default(TEXT)
  createdAt   DateTime    @default(now())
}

// ============================================
// Matching participants
// ============================================
model MatchParticipant {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  role   ParticipantRole   @default(PLAYER)
  status ParticipantStatus @default(INVITED)

  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([bookingId, userId])
}